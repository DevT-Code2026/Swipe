# Hostinger / MySQL database
# You can use either DATABASE_URL or the individual HOSTINGER_DB_* fields.
DATABASE_URL=mysql://your-db-user:your-db-password@your-db-host:3306/your-db-name

HOSTINGER_DB_HOST=your-db-host
HOSTINGER_DB_PORT=3306
HOSTINGER_DB_USER=your-db-user
HOSTINGER_DB_PASSWORD=your-db-password
HOSTINGER_DB_NAME=your-db-name
DB_CONNECTION_LIMIT=5

# JWT Secrets
JWT_SECRET=your-jwt-secret-min-32-chars-long
JWT_CREATOR_EXPIRY=8h
JWT_REVIEWER_EXPIRY=4h

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match the authorized redirect URIs in Google Cloud Console:
# https://giggidy.work/api/auth/google/callback
# https://giggidy.work/api/reviewer/auth/google/callback
GOOGLE_CALLBACK_BASE=https://giggidy.work

# Cloudflare CDN (optional, Phase 3)
CLOUDFLARE_CDN_DOMAIN=cdn.yourdomain.com
CLOUDFLARE_TOKEN_SECRET=your-cf-token-secret

# Email Notifications (optional, Phase 2)
SENDGRID_API_KEY=your-sendgrid-key
NOTIFICATION_FROM_EMAIL=noreply@creativeswipe.app
